{
  "name": "@fabriziosalmi/slopless",
  "version": "1.15.1",
  "description": "",
  "main": "dist/index.js",
  "bin": {
    "slopless": "dist/index.js"
  },
  "files": [
    "dist",
    "rules"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsup",
    "docs:dev": "npm run docs:gen && vitepress dev docs",
    "docs:gen": "ts-node scripts/generate-rule-docs.ts",
    "docs:build": "npm run docs:gen && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "verify:bundle": "node scripts/verify-bundle.js",
    "verify:action": "bash scripts/run-action-locally.sh . 'src/**/*.ts'",
    "release:prep": "npm run docs:gen && npm run build && npm test && npm run verify:bundle",
    "version": "node scripts/check-changelog.js && npm run docs:gen && npm run build && git add dist docs README.md"
  },
  "keywords": [
    "linter",
    "static-analysis",
    "anti-vibecoding",
    "sarif"
  ],
  "author": "Fabrizio Salmi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabriziosalmi/slopless.git"
  },
  "homepage": "https://fabriziosalmi.github.io/slopless/",
  "bugs": {
    "url": "https://github.com/fabriziosalmi/slopless/issues"
  },
  "type": "commonjs",
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.0.18",
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "ignore": "^7.0.5",
    "js-yaml": "^5.4.1",
    "minimatch": "^10.2.6",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "zod": "^4.3.6"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "publishConfig": {
    "access": "public"
  }
}
