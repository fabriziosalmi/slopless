{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2022",
        "lib": ["es2022"],
        "outDir": "out",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": ["src"]
}
