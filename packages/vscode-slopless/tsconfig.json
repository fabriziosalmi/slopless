{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2022",
        "lib": [
            "es2022"
        ],
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "composite": true
    },
    "exclude": [
        "node_modules"
    ],
    "files": [],
    "references": [
        {
            "path": "./client"
        },
        {
            "path": "./server"
        }
    ]
}
