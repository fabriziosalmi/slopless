{
    "name": "vscode-slopless",
    "description": "Slopless language server and VS Code integration",
    "version": "1.0.0",
    "publisher": "slopless",
    "engines": {
        "vscode": "^1.75.0"
    },
    "activationEvents": [
        "onLanguage:javascript",
        "onLanguage:typescript",
        "onLanguage:javascriptreact",
        "onLanguage:typescriptreact"
    ],
    "main": "./client/out/extension.js",
    "contributes": {
        "configuration": {
            "type": "object",
            "title": "Slopless",
            "properties": {
                "slopless.enable": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable/disable Slopless statically analyzing your code."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -b",
        "watch": "tsc -b -w"
    },
    "dependencies": {
        "vscode-languageclient": "^8.1.0",
        "vscode-languageserver": "^8.1.0",
        "vscode-languageserver-textdocument": "^1.0.8",
        "vscode-uri": "^3.0.7",
        "slopless": "file:../.."
    },
    "devDependencies": {
        "@types/node": "^16.0.0",
        "@types/vscode": "^1.75.0",
        "typescript": "^5.0.0"
    }
}