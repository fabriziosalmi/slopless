{
    "name": "vscode-slopless",
    "description": "Static analysis for AI-slop patterns: squiggles as you type, and a panel for the whole workspace.",
    "version": "1.16.0",
    "publisher": "slopless",
    "engines": {
        "vscode": "^1.75.0"
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./client/out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "slopless",
                    "title": "Slopless",
                    "icon": "media/slopless.svg"
                }
            ]
        },
        "views": {
            "slopless": [
                {
                    "id": "sloplessFindings",
                    "name": "Findings"
                }
            ]
        },
        "commands": [
            {
                "command": "slopless.scan",
                "title": "Scan the workspace",
                "category": "Slopless",
                "icon": "$(refresh)"
            },
            {
                "command": "slopless.reveal",
                "title": "Go to finding",
                "category": "Slopless"
            },
            {
                "command": "slopless.copyReport",
                "title": "Copy the report",
                "category": "Slopless",
                "icon": "$(clippy)"
            },
            {
                "command": "slopless.copyFinding",
                "title": "Copy this finding, with its lines",
                "category": "Slopless"
            },
            {
                "command": "slopless.copySuppression",
                "title": "Copy a disable marker for this rule",
                "category": "Slopless"
            },
            {
                "command": "slopless.openRuleDocs",
                "title": "What this rule is about",
                "category": "Slopless"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "slopless.scan",
                    "when": "view == sloplessFindings",
                    "group": "navigation"
                },
                {
                    "command": "slopless.copyReport",
                    "when": "view == sloplessFindings",
                    "group": "navigation@1"
                }
            ],
            "commandPalette": [
                {
                    "command": "slopless.reveal",
                    "when": "false"
                },
                {
                    "command": "slopless.copyFinding",
                    "when": "false"
                },
                {
                    "command": "slopless.copySuppression",
                    "when": "false"
                },
                {
                    "command": "slopless.openRuleDocs",
                    "when": "false"
                }
            ],
            "view/item/context": [
                {
                    "command": "slopless.copyFinding",
                    "when": "view == sloplessFindings && viewItem == finding",
                    "group": "1@1"
                },
                {
                    "command": "slopless.copySuppression",
                    "when": "view == sloplessFindings && viewItem == finding",
                    "group": "1@2"
                },
                {
                    "command": "slopless.openRuleDocs",
                    "when": "view == sloplessFindings && viewItem == finding",
                    "group": "2@1"
                }
            ]
        },
        "configuration": {
            "type": "object",
            "title": "Slopless",
            "properties": {
                "slopless.enable": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable/disable Slopless statically analyzing your code."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run bundle",
        "typecheck": "tsc -b",
        "bundle": "node build.js",
        "package": "npm run bundle && npx --yes @vscode/vsce package --no-dependencies --out slopless.vsix"
    },
    "dependencies": {
        "vscode-languageclient": "^8.1.0",
        "vscode-languageserver": "^8.1.0",
        "vscode-languageserver-textdocument": "^1.0.8",
        "vscode-uri": "^3.0.7",
        "slopless": "file:../.."
    },
    "devDependencies": {
        "@types/node": "^16.0.0",
        "@types/vscode": "^1.75.0",
        "typescript": "^5.0.0"
    },
    "displayName": "Slopless",
    "categories": [
        "Linters",
        "Programming Languages"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/fabriziosalmi/slopless.git",
        "directory": "packages/vscode-slopless"
    },
    "license": "MIT"
}
